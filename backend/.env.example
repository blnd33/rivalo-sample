# ---------------------------------------------------------------------------
# RIVALO backend environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
APP_NAME=RIVALO
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public base URL of this server (used in email links). Example staging: https://api.staging.example.com
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database: PostgreSQL 16+ (recommended for every environment).
# Quick start without Postgres: set DB_CONNECTION=sqlite and comment out the DB_* lines below
# (database/database.sqlite is created automatically). Tests always use in-memory SQLite.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rivalo
DB_USERNAME=rivalo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in staging/production (HTTPS only cookies).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer). Leave empty locally.
TRUSTED_PROXIES=

# Optional: Redis for queue/cache when traffic grows (QUEUE_CONNECTION=redis, CACHE_STORE=redis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail: "log" writes emails to storage/logs/laravel.log locally.
# Staging/production: use your SMTP provider's credentials.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Media storage. Locally "public" maps to storage/app/public (run: php artisan storage:link).
# Production: an S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# RIVALO
# ---------------------------------------------------------------------------
# Monitored support inbox shown in the app (required before pilot).
RIVALO_SUPPORT_EMAIL=

# Push provider (Milestone 6): log | fcm. Credentials file stays on the server, never in the app.
PUSH_DRIVER=log
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Development only: password for accounts created by SampleDataSeeder. If empty, a random one is printed.
SAMPLE_DATA_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
